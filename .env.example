# Bright Data Scraper Studio
BRIGHT_DATA_API_TOKEN=your_api_token_here
BRIGHT_DATA_COLLECTOR_NPM=c_xxxxxxxx
BRIGHT_DATA_COLLECTOR_GITHUB=c_xxxxxxxx
BRIGHT_DATA_COLLECTOR_CHAOS=c_xxxxxxxx

# Public URL of fixtures/chaos-page (must be reachable by Bright Data)
# Local: host chaos-page yourself. On Zerops web service: https://<web-subdomain>/chaos/
CHAOS_PAGE_URL=https://your-chaos-page.vercel.app/

# Orchestration API (web-ui → mcp-server HTTP)
# Local defaults. On Zerops, web proxies /api/* to http://api:8787 via Next rewrites.
CHANGELOG_RADAR_API_PORT=8787
CHANGELOG_RADAR_API_URL=http://127.0.0.1:8787

# Optional: force browser to call API directly (skip Next proxy). Leave unset on Zerops.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Set to 1 to run without Bright Data (deterministic fixtures)
CHANGELOG_RADAR_MOCK=0

# Optional: review scrape URLs + summarize audit results. Leave empty to skip.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
