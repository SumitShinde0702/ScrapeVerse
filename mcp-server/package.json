{
  "name": "@changelog-radar/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "changelog-radar-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/http.ts",
    "start": "node dist/http.js",
    "mcp": "node dist/mcp.js",
    "prove:live": "tsx src/scripts/prove-live.ts",
    "prove:heal": "tsx src/scripts/prove-heal.ts"
  },
  "dependencies": {
    "@changelog-radar/shared": "*",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
